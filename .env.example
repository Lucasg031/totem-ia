# ── Totem IA — Environment Variables ──────────────────────────────
# Copy this file to .env and fill in your values.
#   cp .env.example .env
#   nano .env

# Required: OpenAI API key for the AI assistant
OPENAI_API_KEY=sk-your-openai-key-here

# DuckDNS domain (free)
# Create at https://duckdns.org and update your token below
DOMAIN=meutotem.duckdns.org
DUCKDNS_TOKEN=your-duckdns-token-here

# Frontend: absolute URL for API calls
# Render: https://totem-ia.onrender.com/api
VITE_API_URL=https://meutotem.duckdns.org/api

# Database (optional — leave empty to use SQLite via sql.js)
DATABASE_URL=

# Backend port (Render define automaticamente via $PORT)
PORT=3001

# Node environment
NODE_ENV=production
